{
  "name": "backend",
  "version": "1.0.0",
  "description": "Midway.js + TypeORM Backend",
  "private": true,
  "scripts": {
    "dev": "midway-bin dev",
    "build": "midway-bin build",
    "start": "node ./bootstrap.js",
    "lint": "eslint src --ext .ts",
    "check": "npm run lint && npm run test",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "migration:generate": "typeorm migration:generate -d src/config/dataSource.ts",
    "migration:run": "typeorm migration:run -d src/config/dataSource.ts",
    "migration:revert": "typeorm migration:revert -d src/config/dataSource.ts"
  },
  "dependencies": {
    "@midwayjs/core": "^3.15.0",
    "@midwayjs/decorator": "^3.15.0",
    "@midwayjs/koa": "^3.15.0",
    "@midwayjs/typeorm": "^3.15.0",
    "@midwayjs/swagger": "^3.15.0",
    "@midwayjs/validate": "^3.15.0",
    "typeorm": "^0.3.17",
    "mysql2": "^3.6.0",
    "koa": "^2.14.0",
    "koa-bodyparser": "^4.4.0",
    "koa-router": "^12.0.0"
  },
  "devDependencies": {
    "@midwayjs/cli": "^2.0.0",
    "@midwayjs/mock": "^3.15.0",
    "@types/koa": "^2.14.0",
    "@types/node": "^20.10.0",
    "eslint": "^8.55.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.0",
    "typescript": "^5.3.0"
  }
}
